# Generated by XcodeGen (project.yml is the source of truth)
*.xcodeproj
*.xcworkspace
App/Info.plist

# Build output
build/
DerivedData/
.build/
.swiftpm/
*.xcresult
xcuserdata/

# Python
__pycache__/
*.pyc

# OS / editors
.DS_Store
.vscode/
.idea/

# Secrets (signing, App Store Connect keys) never go in git
*.p8
*.p12
*.mobileprovision
.env*

# Terraform: state lives in S3 (ADR-0021); local state, plans and contact details never go in git
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
